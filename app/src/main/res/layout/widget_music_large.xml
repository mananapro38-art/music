<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetLargeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widgetLargeArtwork"
        android:layout_width="108dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_search"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note"
        android:contentDescription="앨범 아트" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView android:id="@+id/widgetLargeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="No Limit Music" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/widgetLargeArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="재생할 곡을 선택하세요" android:textColor="@color/muted" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widgetLargeLike" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="♡" android:textColor="@color/text_primary" android:textSize="21sp" />
            <TextView android:id="@+id/widgetLargePrevious" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="|◀" android:textColor="@color/text_primary" android:textSize="16sp" />
            <TextView android:id="@+id/widgetLargePlayPause" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="▶" android:textColor="@color/text_primary" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:id="@+id/widgetLargeNext" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="▶|" android:textColor="@color/text_primary" android:textSize="16sp" />
            <TextView android:id="@+id/widgetLargeShuffle" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="⤨" android:textColor="@color/text_primary" android:textSize="18sp" />
            <TextView android:id="@+id/widgetLargeRepeat" android:layout_width="40dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textColor="@color/text_primary" android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
