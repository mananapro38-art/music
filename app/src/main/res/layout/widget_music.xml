<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="9dp"
    android:paddingTop="5dp"
    android:paddingRight="7dp"
    android:paddingBottom="5dp">

    <ImageView
        android:id="@+id/widgetArtwork"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_search"
        android:contentDescription="앨범 아트"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="No Limit Music"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="재생할 곡을 선택하세요"
            android:textColor="@color/muted"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetPrevious"
        android:layout_width="34dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="|◀"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widgetPlayPause"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="▶"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetNext"
        android:layout_width="34dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="▶|"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />
</LinearLayout>
