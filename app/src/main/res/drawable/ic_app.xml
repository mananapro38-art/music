<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0914" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:left="17dp"
        android:top="17dp"
        android:right="17dp"
        android:bottom="17dp">
        <bitmap
            android:src="@drawable/ic_app_logo"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
